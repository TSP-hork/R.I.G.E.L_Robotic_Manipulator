// ============================================================
// SYSTEM SIGNALS
// Pin assignments for the main clock source and reset button
// ============================================================
IO_LOC "clk" 52;                          // 27 MHz on-board oscillator input
IO_PORT "clk" PULL_MODE=UP;
IO_LOC "btn1" 3;                          // User push-button — directly used as active-low reset (rst_n)
IO_PORT "btn1" PULL_MODE=UP;

// ============================================================
// SPI TO STM32H7 (FPGA = MASTER)
// Main data link: FPGA sends encoder+ADC data, receives PWM commands
// ============================================================
IO_LOC "spi_cs_n" 27;                     // Chip-select to STM32 (active low, triggers EXTI for DMA setup)
IO_LOC "spi_sck"  28;                     // SPI clock generated by FPGA (up to 13.5 MHz)
IO_LOC "spi_mosi" 29;                     // FPGA → STM32 data line (sensor payload)
IO_LOC "spi_miso" 30;                     // STM32 → FPGA data line (PWM duty commands)
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33;
IO_PORT "spi_sck"  IO_TYPE=LVCMOS33;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33;

// ============================================================
// MOTOR-SIDE ENCODERS (3 axes × quadrature A/B)
// Connected to the motor shaft — used for commutation and speed
// ============================================================
IO_LOC "enc_m_a[0]" 25;                   // Axis 0 motor encoder, phase A
IO_LOC "enc_m_b[0]" 26;                   // Axis 0 motor encoder, phase B
IO_LOC "enc_m_a[1]" 31;                   // Axis 1 motor encoder, phase A
IO_LOC "enc_m_b[1]" 32;                   // Axis 1 motor encoder, phase B
IO_LOC "enc_m_a[2]" 33;                   // Axis 2 motor encoder, phase A
IO_LOC "enc_m_b[2]" 34;                   // Axis 2 motor encoder, phase B

IO_PORT "enc_m_a[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;  // Pull-up for noise immunity when cable is disconnected
IO_PORT "enc_m_b[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_m_a[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_m_b[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_m_a[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_m_b[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ============================================================
// OUTPUT-SIDE (LOAD) ENCODERS (3 axes × quadrature A/B)
// Connected after the gearbox — used for position feedback
// Note: enc_o_b[2] is currently unrouted (commented out)
// ============================================================
IO_LOC "enc_o_a[0]" 35;                   // Axis 0 output encoder, phase A
IO_LOC "enc_o_b[0]" 36;                   // Axis 0 output encoder, phase B
IO_LOC "enc_o_a[1]" 37;                   // Axis 1 output encoder, phase A
IO_LOC "enc_o_b[1]" 38;                   // Axis 1 output encoder, phase B
IO_LOC "enc_o_a[2]" 39;                   // Axis 2 output encoder, phase A
// IO_LOC "enc_o_b[2]" 40;               // Axis 2 output encoder, phase B — pin 40 reassigned to G4 MISO

IO_PORT "enc_o_a[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_o_b[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_o_a[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_o_b[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_PORT "enc_o_a[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
// IO_PORT "enc_o_b[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ============================================================
// GATE DRIVE OUTPUTS (PWM) — 3 axes × 3 phases × high/low side
// Drive the half-bridge MOSFETs/IGBTs via gate driver ICs.
// Some pins were reassigned from original 54–57 to avoid conflicts.
// ============================================================

// --- AXIS 0 ---
IO_LOC "gate_a_h[0]" 41;                  // Axis 0, phase A, high-side gate
IO_LOC "gate_a_l[0]" 42;                  // Axis 0, phase A, low-side gate
IO_LOC "gate_b_h[0]" 51;                  // Axis 0, phase B, high-side gate
IO_LOC "gate_b_l[0]" 53;                  // Axis 0, phase B, low-side gate
IO_LOC "gate_c_h[0]" 48;                  // Axis 0, phase C, high-side gate (moved from pin 54)
IO_LOC "gate_c_l[0]" 49;                  // Axis 0, phase C, low-side gate  (moved from pin 55)

// --- AXIS 1 ---
IO_LOC "gate_a_h[1]" 71;                  // Axis 1, phase A, high-side gate (moved from pin 56)
IO_LOC "gate_a_l[1]" 72;                  // Axis 1, phase A, low-side gate  (moved from pin 57)
IO_LOC "gate_b_h[1]" 73;                  // Axis 1, phase B, high-side gate
IO_LOC "gate_b_l[1]" 74;                  // Axis 1, phase B, low-side gate
IO_LOC "gate_c_h[1]" 75;                  // Axis 1, phase C, high-side gate
IO_LOC "gate_c_l[1]" 76;                  // Axis 1, phase C, low-side gate

// --- AXIS 2 ---
IO_LOC "gate_a_h[2]" 77;                  // Axis 2, phase A, high-side gate
IO_LOC "gate_a_l[2]" 79;                  // Axis 2, phase A, low-side gate
IO_LOC "gate_b_h[2]" 80;                  // Axis 2, phase B, high-side gate
IO_LOC "gate_b_l[2]" 81;                  // Axis 2, phase B, low-side gate
IO_LOC "gate_c_h[2]" 82;                  // Axis 2, phase C, high-side gate
IO_LOC "gate_c_l[2]" 83;                  // Axis 2, phase C, low-side gate

// All gate outputs: 3.3 V LVCMOS (directly driving external gate-driver ICs)
IO_PORT "gate_a_h[0]" IO_TYPE=LVCMOS33; IO_PORT "gate_a_l[0]" IO_TYPE=LVCMOS33;
IO_PORT "gate_b_h[0]" IO_TYPE=LVCMOS33; IO_PORT "gate_b_l[0]" IO_TYPE=LVCMOS33;
IO_PORT "gate_c_h[0]" IO_TYPE=LVCMOS33; IO_PORT "gate_c_l[0]" IO_TYPE=LVCMOS33;
IO_PORT "gate_a_h[1]" IO_TYPE=LVCMOS33; IO_PORT "gate_a_l[1]" IO_TYPE=LVCMOS33;
IO_PORT "gate_b_h[1]" IO_TYPE=LVCMOS33; IO_PORT "gate_b_l[1]" IO_TYPE=LVCMOS33;
IO_PORT "gate_c_h[1]" IO_TYPE=LVCMOS33; IO_PORT "gate_c_l[1]" IO_TYPE=LVCMOS33;
IO_PORT "gate_a_h[2]" IO_TYPE=LVCMOS33; IO_PORT "gate_a_l[2]" IO_TYPE=LVCMOS33;
IO_PORT "gate_b_h[2]" IO_TYPE=LVCMOS33; IO_PORT "gate_b_l[2]" IO_TYPE=LVCMOS33;
IO_PORT "gate_c_h[2]" IO_TYPE=LVCMOS33; IO_PORT "gate_c_l[2]" IO_TYPE=LVCMOS33;

// ============================================================
// DEBUG LEDs (Tang Nano 9K on-board LEDs, accent active-low)
// Used for visual status indication during development
// ============================================================
IO_LOC "led[0]" 10;                       // LED 0: phase-A duty diagnostic
IO_LOC "led[1]" 11;                       // LED 1: phase-B duty diagnostic
IO_LOC "led[2]" 13;                       // LED 2: phase-C duty diagnostic
IO_LOC "led[3]" 14;                       // LED 3: axis 0 enable status
IO_LOC "led[4]" 15;                       // LED 4: STM32 link status (link_ok)
IO_LOC "led[5]" 16;                       // LED 5: heartbeat blink (~0.8 Hz, proves clock is running)
IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;

// ============================================================
// G4 ADC SPI (FPGA = MASTER, STM32G4 = SLAVE)
// Three independent SPI buses, one per axis. Each G4 provides
// two 16-bit ADC current measurements (phase A + phase B),
// packed into a single 32-bit SPI frame.
// MISO lines have pull-downs to ensure a defined level when
// the G4 is not driving (idle / not populated).
// ============================================================

// --- Axis 0 ADC ---
IO_LOC "g4_cs_n[0]" 85;                   // Chip-select for axis 0 G4 ADC slave
IO_LOC "g4_sck[0]"  86;                   // SPI clock for axis 0 G4
IO_LOC "g4_miso[0]" 40;                   // ADC data from axis 0 G4 (was enc_o_b[2] pin)

// --- Axis 1 ADC ---
IO_LOC "g4_cs_n[1]" 57;                   // Chip-select for axis 1 G4 ADC slave
IO_LOC "g4_sck[1]"  68;                   // SPI clock for axis 1 G4
IO_LOC "g4_miso[1]" 69;                   // ADC data from axis 1 G4

// --- Axis 2 ADC ---
IO_LOC "g4_cs_n[2]" 70;                   // Chip-select for axis 2 G4 ADC slave
IO_LOC "g4_sck[2]"  63;                   // SPI clock for axis 2 G4
IO_LOC "g4_miso[2]" 84;                   // ADC data from axis 2 G4

IO_PORT "g4_cs_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "g4_sck[0]"  IO_TYPE=LVCMOS33;
IO_PORT "g4_miso[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;  // Pull-down: reads zero when G4 absent
IO_PORT "g4_cs_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "g4_sck[1]"  IO_TYPE=LVCMOS33;
IO_PORT "g4_miso[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;  // Pull-down: reads zero when G4 absent
IO_PORT "g4_cs_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "g4_sck[2]"  IO_TYPE=LVCMOS33;
IO_PORT "g4_miso[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;  // Pull-down: reads zero when G4 absent